# Supabase — get these from supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to 'true' only in Cole's build — gives Comply/Ignore controls in the feedback feed
VITE_ADMIN=false

# Keep the mobile client aligned with the server's explicitly approved release stage.
VITE_OPERATOR_RELEASE_STAGE=core

# Keep false until Base 1520 holds written commercial mobile-app permission from Crossway.
VITE_ESV_MOBILE_LICENSED=false
