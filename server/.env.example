# Core runtime
DATABASE_URL=postgresql://user:password@host:5432/operator
ANTHROPIC_API_KEY=replace-me
PORT=8080
OPERATOR_API_PUBLIC_URL=https://api-production-15e5e.up.railway.app
OPERATOR_WEB_PUBLIC_URL=https://www.base1520.com/operator
OPERATOR_ALLOWED_ORIGINS=https://www.base1520.com
OPERATOR_RELEASE_STAGE=core
ESV_MOBILE_LICENSED=false

# Identity, trial protection, and administration
TRIAL_IDENTITY_SECRET=generate-a-dedicated-random-secret-of-at-least-32-characters
ACCOUNT_RECOVERY_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
OPERATOR_ADMIN_EMAILS=cole@base1520.com
OPERATOR_COMP_CODES=

# Transactional email for secure reinstall and lost-device recovery
RESEND_API_KEY=re_replace_me
OPERATOR_AUTH_FROM_EMAIL=The Operator <access@base1520.com>

# Stripe web subscriptions and top-ups
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_STARTER_ANNUAL=price_replace_me
STRIPE_PRICE_STANDARD=price_replace_me
STRIPE_PRICE_STANDARD_ANNUAL=price_replace_me
STRIPE_PRICE_HEAVY=price_replace_me
STRIPE_PRICE_HEAVY_ANNUAL=price_replace_me
STRIPE_PRICE_TOPUP=price_replace_me

# Apple App Store subscriptions
# Create the six appleProductId values in server/src/iap-products.json inside one subscription group.
APPLE_APP_ID=replace-with-the-numeric-app-store-id
IAP_SANDBOX_ACCOUNT_EMAILS=app-review@base1520.com

# Google Play subscriptions and Real-time Developer Notifications
# Create one subscription product, com.base1520.theoperator.subscription, with the six base plans in server/src/iap-products.json.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
GOOGLE_RTDN_AUDIENCE=replace-with-the-pubsub-push-audience
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=replace-with-the-pubsub-push-service-account

# Marketing sync; account creation never implies opt-in
MAILCHIMP_API_KEY=replace-me
MAILCHIMP_AUDIENCE_ID=replace-me

# Spiritual Operator's Manual fulfillment, hosted by the same service
SOM_DOWNLOAD_SIGNING_SECRET=generate-a-random-secret-of-at-least-32-characters
SOM_SALES_URL=https://www.base1520.com/spiritual-operators-manual/
SOM_OBJECT_KEY=replace-me
STRIPE_PRICE_SOM_DIGITAL=price_replace_me
BUCKET_ENDPOINT=replace-me
BUCKET_NAME=replace-me
BUCKET_ACCESS_KEY_ID=replace-me
BUCKET_SECRET_ACCESS_KEY=replace-me
